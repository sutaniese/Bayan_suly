# Optional: Groq API key for cloud TTS (Bota Voice Guide / Read aloud).
# Create a key at https://console.groq.com/keys
#
# Vite exposes VITE_* variables in the browser bundle. Do not use a valuable production key here
# unless you understand the risk; prefer a backend proxy for real deployments.
VITE_GROQ_API_KEY=

# Optional Groq TTS overrides (defaults work for English Orpheus):
# VITE_GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# VITE_GROQ_TTS_VOICE=hannah
# VITE_GROQ_TTS_FORMAT=wav
